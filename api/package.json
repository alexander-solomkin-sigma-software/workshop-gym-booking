{
  "name": "@gym/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gym Class Booking API — Express + better-sqlite3.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
